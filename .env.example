# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - this file only documents what's required.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=hnanalyzer
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Hacker News's public Firebase-backed API - no auth needed. Override to
# point at a mock/local server for testing.
HN_API_BASE_URL=https://hacker-news.firebaseio.com/v0
